<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Deliberately not sandboxed: Teleport ships via direct Developer ID
         DMG, not the Mac App Store, and App Sandbox is incompatible with
         `do shell script ... with administrator privileges`, which the
         "Install Command Line Tool" feature (Settings > General) needs to
         symlink tport into /usr/local/bin. See git history for the
         earlier sandboxed entitlements this replaced. -->
</dict>
</plist>
